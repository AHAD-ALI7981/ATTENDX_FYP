# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_db

# JWT — CHANGE THIS! Use a strong random secret key
JWT_SECRET=CHANGE-ME-TO-A-STRONG-RANDOM-SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Default Admin Account (used only during initial seeding)
DEFAULT_ADMIN_PASSWORD=CHANGE-ME-admin-strong-password

# Email / SMTP Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Environment: set to "production" for HTTPS secure cookies
ENVIRONMENT=development
